# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/hackmatch?schema=public"

# Redis Cache & Pub/Sub
REDIS_URL="redis://localhost:6379"

# Authentication & Security
# Generate a secure 256-bit secret key in production (e.g., using: openssl rand -base64 32)
JWT_SECRET="your_jwt_secret_key_minimum_32_characters_for_hs256_security"
JWT_EXPIRES_IN="7d"
